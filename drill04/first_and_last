def first_and_last(value):
    if value == "":
        return{
            "first": ""
            "last": ""
        }
    return {
        "first" : value[0],
        "last" : value[-1]
    }

def clean_username(value):
    value = value.strip()
    value = value.lower()
    return value.replace(" ", "_")

def str_len(value):
    count = 0
    for char in value:
        count += 1
    return count


def reverse_string(value):
    result = ""
    for i in range(len(value) -1, -1, -1):
        result += value[i]

    return result

def censor_words(text, banned_word):
    return text.replace(banned_word, "***")